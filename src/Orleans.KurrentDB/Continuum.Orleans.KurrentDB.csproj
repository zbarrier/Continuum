<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<IsAotCompatible>true</IsAotCompatible>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<RootNamespace>Continuum.Orleans.KurrentDB</RootNamespace>
	<PackageId>Continuum.Orleans.KurrentDB</PackageId>
	<Description>Shared KurrentDB building blocks for Continuum's Orleans providers: credential options and the storage exception.</Description>
	<PackageTags>orleans;kurrentdb;eventstoredb</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="KurrentDB.Client" Version="1.6.0" />
	<PackageReference Include="Microsoft.Orleans.Runtime" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Core.Orleans\Continuum.Core.Orleans.csproj" />
  </ItemGroup>

</Project>
