<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<IsAotCompatible>true</IsAotCompatible>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<PackageId>Continuum.Streaming.Orleans.TestHarness</PackageId>
	<Description>Given/When/Then test harness for Continuum.Streaming.Orleans projection grains running in an Orleans TestCluster, with duplicate delivery and replay-after-reactivation checks.</Description>
	<PackageTags>streaming;projections;orleans;testing;given-when-then;testcluster</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.4.2" />
	<PackageReference Include="xunit.v3.assert" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Streaming.Orleans\Continuum.Streaming.Orleans.csproj" />
  </ItemGroup>

</Project>
