<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Continuum.EventSourcing.Orleans.KurrentDB.Abstractions</PackageId>
    <Description>Shared KurrentDB event metadata contracts for Continuum: the metadata type and the codec for the JSON document KurrentDB stores in an event's metadata slot.</Description>
    <PackageTags>event-sourcing;orleans;kurrentdb;eventstoredb;metadata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KurrentDB.Client" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventSourcing.Orleans\Continuum.EventSourcing.Orleans.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
