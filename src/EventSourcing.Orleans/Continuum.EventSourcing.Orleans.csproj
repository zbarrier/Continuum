<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Continuum.EventSourcing.Orleans</PackageId>
    <Description>Microsoft Orleans implementation of Continuum.EventSourcing: serializable, immutable event metadata for journaled grains and log-consistency providers.</Description>
    <PackageTags>event-sourcing;orleans;journaled-grain;log-consistency;metadata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.EventSourcing" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Orleans\Continuum.Core.Orleans.csproj" />
    <ProjectReference Include="..\EventSourcing\Continuum.EventSourcing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Continuum.EventSourcing.Orleans.CosmosDB" />
    <InternalsVisibleTo Include="Continuum.EventSourcing.Orleans.KurrentDB" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
