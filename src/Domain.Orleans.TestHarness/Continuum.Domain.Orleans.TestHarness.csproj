<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<IsAotCompatible>true</IsAotCompatible>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<PackageId>Continuum.Domain.Orleans.TestHarness</PackageId>
	<Description>Given/When/Then test harnesses for Continuum.Domain.Orleans event-driven and state machine grains running in an Orleans TestCluster.</Description>
	<PackageTags>domain;event-sourcing;orleans;testing;given-when-then;testcluster</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.3.1" />
	<PackageReference Include="xunit.v3.assert" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Domain.Orleans\Continuum.Domain.Orleans.csproj" />
  </ItemGroup>

</Project>
