<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Continuum.CSharpFunctionalExtensions.Orleans</RootNamespace>
    <PackageId>Continuum.CSharpFunctionalExtensions.Orleans</PackageId>
    <Description>Microsoft Orleans serialization surrogates for Continuum.CSharpFunctionalExtensions (Result, Result&lt;T&gt;, Maybe&lt;T&gt;, RequestError, ValidationError).</Description>
    <PackageTags>functional;result;maybe;orleans;serialization;surrogate</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpFunctionalExtensions\Continuum.CSharpFunctionalExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
