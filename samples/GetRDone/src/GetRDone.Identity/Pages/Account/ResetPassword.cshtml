@page
@model GetRDone.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-card card shadow-sm mx-auto">
    <div class="card-body p-4">
        <h1 class="h4 mb-3">Reset password</h1>
        @if (Model.Completed)
        {
            <div class="alert alert-success" role="alert">Your password has been reset.</div>
            <a class="btn btn-primary w-100" asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
        }
        else
        {
            <partial name="_ValidationSummary" />
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="Input.Code" />
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Email"></label>
                    <input class="form-control" asp-for="Input.Email" autocomplete="email" autofocus />
                    <span class="text-danger small" asp-validation-for="Input.Email"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Password"></label>
                    <input class="form-control" asp-for="Input.Password" autocomplete="new-password" />
                    <span class="text-danger small" asp-validation-for="Input.Password"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label" asp-for="Input.ConfirmPassword"></label>
                    <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <span class="text-danger small" asp-validation-for="Input.ConfirmPassword"></span>
                </div>
                <button class="btn btn-primary w-100" type="submit">Reset password</button>
            </form>
        }
    </div>
</div>
