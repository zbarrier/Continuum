@page
@model GetRDone.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card card shadow-sm mx-auto">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Forgot your password?</h1>
        @if (Model.Submitted)
        {
            <div class="alert alert-info mt-3" role="alert">
                If an account exists for <strong>@Model.Email</strong>, we sent a link to reset the password.
            </div>
        }
        else
        {
            <p class="text-muted mb-4">Enter your email and we'll send you a link to reset your password.</p>
            <partial name="_ValidationSummary" />
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-4">
                    <label class="form-label" asp-for="Email"></label>
                    <input class="form-control" asp-for="Email" autocomplete="email" autofocus />
                    <span class="text-danger small" asp-validation-for="Email"></span>
                </div>
                <button class="btn btn-primary w-100" type="submit">Send reset link</button>
            </form>
        }
        <p class="text-center mt-3 mb-0 small">
            <a asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
        </p>
    </div>
</div>
