@page
@model GetRDone.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="auth-card card shadow-sm mx-auto">
    <div class="card-body p-4">
        <h1 class="h4 mb-3">Confirm email</h1>
        @if (Model.Confirmed)
        {
            <div class="alert alert-success" role="alert">Your email is confirmed. You can now sign in.</div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">This confirmation link is invalid or has expired.</div>
        }
        <a class="btn btn-primary w-100" asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
    </div>
</div>
