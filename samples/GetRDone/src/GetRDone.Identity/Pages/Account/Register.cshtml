@page
@model GetRDone.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register as a vendor";
}

<div class="auth-card card shadow-sm mx-auto">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Register as a vendor</h1>
        @if (Model.Registered)
        {
            <div class="alert alert-success mt-3" role="alert">
                Thanks for registering. We sent a confirmation link to <strong>@Model.Input.Email</strong>. Confirm your email, then sign in.
            </div>
            <a class="btn btn-primary w-100" asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
        }
        else
        {
            <p class="text-muted mb-4">Join the Get-R-Done vendor network. Clients and coordinators join by invitation.</p>
            <partial name="_ValidationSummary" />
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.DisplayName"></label>
                    <input class="form-control" asp-for="Input.DisplayName" autofocus />
                    <span class="text-danger small" asp-validation-for="Input.DisplayName"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Email"></label>
                    <input class="form-control" asp-for="Input.Email" autocomplete="email" />
                    <span class="text-danger small" asp-validation-for="Input.Email"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Password"></label>
                    <input class="form-control" asp-for="Input.Password" autocomplete="new-password" />
                    <span class="text-danger small" asp-validation-for="Input.Password"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label" asp-for="Input.ConfirmPassword"></label>
                    <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <span class="text-danger small" asp-validation-for="Input.ConfirmPassword"></span>
                </div>
                <button class="btn btn-primary w-100" type="submit">Create account</button>
            </form>
            <p class="text-center mt-3 mb-0 small">
                Already have an account? <a asp-page="/Account/Login/Index" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
            </p>
        }
    </div>
</div>
