@* The staff order page (event model chapter 2, Order screens): the OrderDetails read model, with the actions the signed-in
   user can take, such as requesting documents from the client and writing the description of work for the client to
   approve. Each document links to its download (OrderDocumentDownloads). The description of work is HTML from the rich
   text editor; it is sanitized again before it is shown. OrderDetails is a projection, so after an action the page waits
   for it to show the change. *@
@page "/staff/orders/{OrderGuid:guid}"
@attribute [Authorize(Roles = StaffRoles.AnyStaff)]
@using Continuum.CSharpFunctionalExtensions
@using Continuum.Orleans.Tenancy
@using GetRDone.Orders.Abstractions
@using GetRDone.Orders.Abstractions.OrderAggregate
@using GetRDone.Orders.Abstractions.ReadModels
@inject IClusterClient ClusterClient
@inject ILogger<StaffOrderPage> Logger

<PageTitle>@Title · Get-R-Done</PageTitle>

<MudPaper Elevation="1" Class="pa-6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
        <MudText Typo="Typo.h5">@Title</MudText>
        @if (_details is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="StatusColor(_details.Status)">@StatusText(_details.Status)</MudChip>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Text" Href="/">Home</MudButton>
    </MudStack>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (_details is { } details)
    {
        <MudGrid>
            <MudItem xs="12" md="7">
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><th>Client</th><td>@details.ClientName</td></tr>
                        <tr><th>Entered by</th><td>@details.EnteredByName</td></tr>
                        <tr><th>Form type</th><td>@details.FormTypeName</td></tr>
                        <tr><th>Property</th><td>@details.PropertyAddress</td></tr>
                        <tr><th>Due</th><td>@details.DueDate.ToString("MMM d, yyyy")</td></tr>
                        <tr>
                            <th>Access contact</th>
                            <td>@details.AccessContactName @DisplayFormat.Phone(details.AccessContactPhone)</td>
                        </tr>
                        <tr><th>Assigned to</th><td>@(details.AssignedToName ?? "Nobody yet")</td></tr>
                    </tbody>
                </MudSimpleTable>

                <MudStack Row="true" Spacing="2" Class="mt-4">
                    @if (details.AllowedActions.HasFlag(OrderActions.AssignToMe))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="AssignToMeAsync">Assign to me</MudButton>
                    }
                    @if (details.AllowedActions.HasFlag(OrderActions.Acknowledge))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="AcknowledgeAsync">Acknowledge</MudButton>
                    }
                    @if (details.AllowedActions.HasFlag(OrderActions.RequestDocument) && !_requesting)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="StartRequestAsync">Request a document</MudButton>
                    }
                </MudStack>

                @if (_requesting)
                {
                    <MudPaper Outlined="true" Class="pa-4 mt-4">
                        <MudText Typo="Typo.h6" Class="mb-2">Request a document</MudText>
                        <MudSelect T="DocumentType" Label="Document type" @bind-Value="_requestDocumentType" ToStringFunc="@(type => type?.Name)">
                            @foreach (var type in _documentTypes)
                            {
                                <MudSelectItem Value="type">@type.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_requestMessage" Label="Message to the client" Lines="3" MaxLength="DocumentRequestMessage.MaxLength" Class="mt-2" />
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="CancelRequest">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="RequestDocumentAsync">Send request</MudButton>
                        </MudStack>
                    </MudPaper>
                }

                @if (details.OpenRequests.Length > 0)
                {
                    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Waiting on the client</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var request in details.OpenRequests)
                            {
                                <tr>
                                    <td style="white-space:nowrap">@request.RequestedAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td><strong>@request.DocumentTypeName</strong><br />@request.Message</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                <MudText Typo="Typo.h6" Class="mt-6 mb-2">Documents</MudText>
                <MudSimpleTable Dense="true" Elevation="0" Outlined="true">
                    <tbody>
                        @if (details.Documents.Length == 0)
                        {
                            <tr><td><MudText Typo="Typo.body2" Color="Color.Secondary">No documents.</MudText></td></tr>
                        }
                        @foreach (var document in details.Documents)
                        {
                            <tr>
                                <td><MudLink Href="@OrderDocumentDownloads.Url(details.OrderId, document.DocumentId)" download="@document.FileName">@document.FileName</MudLink></td>
                                <td>@document.DocumentTypeName</td>
                                <td>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Added by @(document.AddedByName ?? "an unknown user"), @document.AddedAt.ToLocalTime().ToString("MMM d, h:mm tt")
                                    </MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                @if (details.DescriptionOfWork is not null || details.AllowedActions.HasFlag(OrderActions.SubmitDescriptionOfWork))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-6 mb-2">
                        <MudText Typo="Typo.h6">Description of work</MudText>
                        @if (details.DescriptionOfWork is { } shown)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@(shown.Approved ? Color.Success : Color.Secondary)">
                                Version @shown.Version @(shown.Approved ? "approved" : "awaiting approval")
                            </MudChip>
                        }
                        <MudSpacer />
                        @if (details.AllowedActions.HasFlag(OrderActions.SubmitDescriptionOfWork) && !_writingDescriptionOfWork)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="StartDescriptionOfWork">
                                @(details.DescriptionOfWork is null ? "Write the description of work" : "Revise")
                            </MudButton>
                        }
                    </MudStack>

                    @if (_writingDescriptionOfWork)
                    {
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudHtmlEditor @bind-Html="_descriptionOfWorkHtml" Placeholder="Describe the work for the client to approve">
                                <MudHtmlToolbarOptions InsertImage="false" />
                            </MudHtmlEditor>
                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="CancelDescriptionOfWork">Cancel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SubmitDescriptionOfWorkAsync">Submit for approval</MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                    else if (details.DescriptionOfWork is { } descriptionOfWork)
                    {
                        @* MudHtmlViewer is height: 100%, which in a grid item is the whole row's height; a div of its own keeps it to its content. *@
                        <div>
                            <MudHtmlViewer Html="@DescriptionOfWorkHtml.Sanitize(descriptionOfWork.Html)" />
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Submitted @descriptionOfWork.SubmittedAt.ToLocalTime().ToString("MMM d, h:mm tt")
                        </MudText>
                    }
                }
            </MudItem>
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.h6" Class="mb-2">Timeline</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        @foreach (var entry in details.Timeline)
                        {
                            <tr>
                                <td style="white-space:nowrap">@entry.OccurredAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                <td>@entry.Entry</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    private const int WaitAttempts = 20;
    private static readonly TimeSpan WaitDelay = TimeSpan.FromMilliseconds(250);

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _orderId = "";
    private string _tenantUserId = "";
    private OrderDetails? _details;
    private bool _requesting;
    private DocumentType[] _documentTypes = [];
    private DocumentType? _requestDocumentType;
    private string _requestMessage = "";
    private bool _writingDescriptionOfWork;
    private string _descriptionOfWorkHtml = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>The order to show. The URL carries only the GUID part of the order ID.</summary>
    [Parameter]
    public Guid OrderGuid { get; set; }

    /// <summary>The URL of the staff order page of <paramref name="orderId"/>, <c>{TenantId}|{OrderGuid}</c>.</summary>
    public static string Url(string orderId)
    {
        TenantKey.Split(orderId, out _, out var orderGuid);
        return $"staff/orders/{orderGuid}";
    }

    public static Color StatusColor(StaffOrderStatus status) => status switch
    {
        StaffOrderStatus.Submitted => Color.Info,
        StaffOrderStatus.Assigned => Color.Warning,
        StaffOrderStatus.Acknowledged => Color.Success,
        StaffOrderStatus.DescriptionOfWorkAwaitingApproval => Color.Secondary,
        StaffOrderStatus.DescriptionOfWorkApproved => Color.Success,
        _ => Color.Default
    };

    public static string StatusText(StaffOrderStatus status) => status switch
    {
        StaffOrderStatus.DescriptionOfWorkAwaitingApproval => "Awaiting DoW approval",
        StaffOrderStatus.DescriptionOfWorkApproved => "DoW approved",
        _ => status.ToString()
    };

    private string Title => _details?.OrderNumber is { } orderNumber ? $"Order {orderNumber}" : "Order";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _details = null;

        var user = (await AuthenticationState).User;
        var tenantId = user.FindFirst("tenant_id")?.Value;
        var userId = user.FindFirst("sub")?.Value;
        if (string.IsNullOrEmpty(tenantId) || string.IsNullOrEmpty(userId))
        {
            _error = "Your account has no tenant.";
            _loading = false;
            return;
        }
        _orderId = TenantKey.Create(tenantId, OrderGuid.ToString());
        _tenantUserId = TenantKey.Create(tenantId, userId);

        try
        {
            var result = await ClusterClient.GetOrderDetailsGrain(_orderId).GetOrderDetailsAsync();
            if (result.IsFailure)
            {
                _error = result.Error.GetFormattedMessage();
                return;
            }
            _details = result.Value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The staff order page could not load order {OrderId}.", _orderId);
            _error = "The order could not be loaded. Try again in a moment.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task AssignToMeAsync()
        => RunAsync(async order => (await order.AssignOrderAsync(new AssignOrderCommand(_tenantUserId))).Map(_ => true),
            details => details.Status == StaffOrderStatus.Assigned);

    private Task AcknowledgeAsync()
        => RunAsync(async order => (await order.AcknowledgeOrderAsync()).Map(_ => true),
            details => details.Status == StaffOrderStatus.Acknowledged);

    private async Task StartRequestAsync()
    {
        _error = null;
        try
        {
            TenantKey.Split(_orderId, out var tenantId, out _);
            _documentTypes = await ClusterClient.GetDocumentTypesGrain(tenantId).GetDocumentTypesAsync();
            _requestDocumentType = null;
            _requestMessage = "";
            _requesting = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The document types could not be loaded for order {OrderId}.", _orderId);
            _error = "The document types could not be loaded. Try again in a moment.";
        }
    }

    private void CancelRequest() => _requesting = false;

    /// <summary>Opens the editor, with the current version when revising it.</summary>
    private void StartDescriptionOfWork()
    {
        _error = null;
        _descriptionOfWorkHtml = _details?.DescriptionOfWork is { } current ? DescriptionOfWorkHtml.Sanitize(current.Html) : "";
        _writingDescriptionOfWork = true;
    }

    private void CancelDescriptionOfWork() => _writingDescriptionOfWork = false;

    /// <summary>
    ///     Submits the first version with a new ID, or a revision of the version shown, so a revision based on a version
    ///     someone else revised in the meantime is rejected.
    /// </summary>
    private async Task SubmitDescriptionOfWorkAsync()
    {
        TenantKey.Split(_orderId, out var tenantId, out _);
        var command = _details?.DescriptionOfWork is { } current
            ? new SubmitDescriptionOfWorkCommand(current.DescriptionOfWorkId, current.Version + 1, _descriptionOfWorkHtml)
            : new SubmitDescriptionOfWorkCommand(TenantKey.Create(tenantId, Guid.NewGuid().ToString()), 1, _descriptionOfWorkHtml);
        var saved = await RunAsync(async order => (await order.SubmitDescriptionOfWorkAsync(command)).Map(_ => true),
            details => details.DescriptionOfWork?.Version == command.DescriptionOfWorkVersion);
        if (saved)
        {
            _writingDescriptionOfWork = false;
        }
    }

    private async Task RequestDocumentAsync()
    {
        TenantKey.Split(_orderId, out var tenantId, out _);
        var requestId = TenantKey.Create(tenantId, Guid.NewGuid().ToString());
        var command = new RequestClientDocumentCommand(
            requestId,
            _requestDocumentType?.DocumentTypeId ?? "", _requestDocumentType?.DocumentTypeVersion ?? 0, _requestDocumentType?.Name ?? "",
            _requestMessage);
        var saved = await RunAsync(async order => (await order.RequestClientDocumentAsync(command)).Map(_ => true),
            details => details.OpenRequests.Any(request => request.RequestId == requestId));
        if (saved)
        {
            _requesting = false;
        }
    }

    /// <summary>
    ///     Runs the command, then reloads the order until the projection shows the change (<paramref name="isShown"/>).
    ///     Returns whether the command succeeded.
    /// </summary>
    private async Task<bool> RunAsync(Func<IOrderGrain, Task<Result<bool>>> command, Func<OrderDetails, bool> isShown)
    {
        _busy = true;
        _error = null;
        var saved = false;
        try
        {
            var result = await command(ClusterClient.GetGrain<IOrderGrain>(_orderId));
            if (result.IsFailure)
            {
                _error = result.Error.GetFormattedMessage();
                return false;
            }
            saved = true;

            for (var attempt = 0; attempt < WaitAttempts; attempt++)
            {
                var details = await ClusterClient.GetOrderDetailsGrain(_orderId).GetOrderDetailsAsync();
                if (details.IsSuccess && isShown(details.Value))
                {
                    _details = details.Value;
                    return true;
                }
                await Task.Delay(WaitDelay);
            }
            _error = "The change was saved, but the page is not showing it yet. Reload the page in a moment.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An action on order {OrderId} failed.", _orderId);
            _error = "The action could not be completed. Try again in a moment.";
        }
        finally
        {
            _busy = false;
        }
        return saved;
    }
}
