@* The tenant's shipped orders (ShippedOrders), the most recently shipped first. *@
@using GetRDone.Orders.Abstractions.ReadModels
@inject IClusterClient ClusterClient

<MudTable T="ShippedOrder" ServerData="LoadAsync" RowsPerPage="5" Hover="true" Elevation="1" Class="@Class">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Shipped (@_total)</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Order #</MudTh>
        <MudTh>Client</MudTh>
        <MudTh>Property</MudTh>
        <MudTh>Shipped</MudTh>
        <MudTh />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Order #">
            @if (context.OrderNumber is { } orderNumber)
            {
                @orderNumber
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pending</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Client">@context.ClientName</MudTd>
        <MudTd DataLabel="Property">@context.PropertyAddress</MudTd>
        <MudTd DataLabel="Shipped">@context.ShippedAt.ToLocalTime().ToString("MMM d, h:mm tt")</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@StaffOrderPage.Url(context.OrderId)">View</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2">@(_error ?? "No shipped orders")</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="PageSizes" />
    </PagerContent>
</MudTable>

@code {
    private static readonly int[] PageSizes = [5, 10, 25];

    private int _total;
    private string? _error;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [Parameter]
    public string? Class { get; set; }

    private async Task<TableData<ShippedOrder>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        var tenantId = (await AuthenticationState).User.FindFirst("tenant_id")?.Value;
        if (string.IsNullOrEmpty(tenantId))
        {
            return Show([], 0, "Your account has no tenant.");
        }

        var result = await ClusterClient.GetShippedOrdersGrain(tenantId)
            .GetOrdersAsync(state.Page * state.PageSize, state.PageSize);
        return result.IsSuccess
            ? Show(result.Value.Orders, result.Value.TotalCount, null)
            : Show([], 0, "The shipped orders could not be loaded.");
    }

    private TableData<ShippedOrder> Show(ShippedOrder[] orders, int total, string? error)
    {
        _error = error;
        if (_total != total)
        {
            _total = total;
            StateHasChanged();
        }
        return new TableData<ShippedOrder> { Items = orders, TotalItems = total };
    }
}
