@* Order entry (event model chapter 1, New order screens): each tab is a component that saves its part of the draft. The
   tabs show the OrderDraft read model, which the order builds from its own events, so they show every save at once (no
   waiting for a projection). Tab 4 comes with its slice. *@
@page "/orders/new"
@page "/orders/drafts/{OrderGuid:guid}"
@attribute [Authorize(Roles = "client")]
@using Continuum.CSharpFunctionalExtensions
@using Continuum.Orleans.Tenancy
@using GetRDone.Orders.Abstractions
@using GetRDone.Orders.Abstractions.OrderAggregate
@using GetRDone.Orders.Abstractions.ReadModels
@using GetRDone.Web.Components.Client.OrderEntryTabs
@inject IClusterClient ClusterClient
@inject NavigationManager Navigation
@inject ILogger<OrderEntry> Logger

<PageTitle>New order · Get-R-Done</PageTitle>

<MudPaper Elevation="1" Class="pa-6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
        <MudText Typo="Typo.h5">@(_draft is null ? "New order" : $"New order · {_draft.PropertyAddress}")</MudText>
        @if (_draft is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success">Draft saved @_draft.LastSavedAt.ToLocalTime().ToString("h:mm tt")</MudChip>
        }
    </MudStack>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (!_ready)
    {
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Text" Href="/">Home</MudButton>
            @if (_canRetry)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Try again</MudButton>
            }
        </MudStack>
    }
    else
    {
        @* KeepPanelsAlive keeps what the user typed on a tab when they switch to another one. *@
        <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" TabPanelsClass="pt-6" KeepPanelsAlive="true">
            <MudTabPanel Text="1 Request & Property">
                <RequestAndPropertyTab TenantId="@_tenantId" NewOrderGuid="_newOrderGuid" ClientId="@_clientId" Draft="_draft"
                                       OrderableServices="_orderableServices" IntendedUses="_intendedUses" OnSaved="RequestAndPropertySaved" />
            </MudTabPanel>
            <MudTabPanel Text="2 Borrower & Access contact" Disabled="@(_draft is null)">
                @if (_draft is not null)
                {
                    <BorrowerAndAccessContactTab Draft="_draft" OnSaved="BorrowerAndAccessContactSaved" OnBack="@(() => _activeTab = RequestTab)" />
                }
            </MudTabPanel>
            <MudTabPanel Text="3 Supporting documents" Disabled="@(_draft is null)">
                @if (_draft is not null)
                {
                    <SupportingDocumentsTab Draft="_draft" DocumentTypes="_documentTypes" OnSaved="SupportingDocumentAttached" OnBack="@(() => _activeTab = BorrowerTab)" />
                }
            </MudTabPanel>
            <MudTabPanel Text="4 Review & Submit" Disabled="true" />
        </MudTabs>
    }
</MudPaper>

@code {
    private const int RequestTab = 0;
    private const int BorrowerTab = 1;
    private const int DocumentsTab = 2;

    private bool _initialized;
    private Guid? _loadedFor;
    private bool _loading = true;
    private bool _ready;
    private bool _canRetry;
    private string? _error;
    private int _activeTab;

    private string _tenantId = "";
    private string _tenantUserId = "";
    private Guid _newOrderGuid;
    private string? _clientId;
    private OrderableService[] _orderableServices = [];
    private IntendedUse[] _intendedUses = [];
    private DocumentType[] _documentTypes = [];
    private OrderDraft? _draft;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>The draft to resume, or <see langword="null"/> for a new order. The URL carries only the GUID part of the order ID.</summary>
    [Parameter]
    public Guid? OrderGuid { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Starting a draft replaces /orders/new with the draft's URL; the page already shows that draft.
        if (_initialized && OrderGuid == _loadedFor)
        {
            return;
        }

        _initialized = true;
        _loadedFor = OrderGuid;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _ready = false;
        _canRetry = false;
        _error = null;
        _clientId = null;
        _draft = null;
        _activeTab = RequestTab;

        var user = (await AuthenticationState).User;
        var tenantId = user.FindFirst("tenant_id")?.Value;
        var userId = user.FindFirst("sub")?.Value;
        if (string.IsNullOrEmpty(tenantId) || string.IsNullOrEmpty(userId))
        {
            _error = "Your account has no tenant.";
            _loading = false;
            return;
        }
        _tenantId = tenantId;
        _tenantUserId = TenantKey.Create(tenantId, userId);

        try
        {
            var optionsTask = LoadOptionsAsync();
            var orderTask = OrderGuid is { } orderGuid
                ? LoadDraftAsync(TenantKey.Create(_tenantId, orderGuid.ToString()))
                : LoadNewOrderAsync();
            await Task.WhenAll(optionsTask, orderTask);
            _ready = orderTask.Result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The order entry page could not load.");
            _error = "The order could not be loaded. Try again in a moment.";
            _canRetry = true;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Loads the services, form types and intended uses tab 1 offers, and the document types tab 3 offers.</summary>
    private async Task LoadOptionsAsync()
    {
        var servicesTask = ClusterClient.GetOrderableServicesGrain(_tenantId).GetOrderableServicesAsync();
        var intendedUsesTask = ClusterClient.GetIntendedUsesGrain(_tenantId).GetIntendedUsesAsync();
        var documentTypesTask = ClusterClient.GetDocumentTypesGrain(_tenantId).GetDocumentTypesAsync();
        await Task.WhenAll(servicesTask, intendedUsesTask, documentTypesTask);

        _orderableServices = servicesTask.Result;
        _intendedUses = intendedUsesTask.Result;
        _documentTypes = documentTypesTask.Result;
    }

    private async Task<bool> LoadNewOrderAsync()
    {
        var users = await ClusterClient.GetUserDirectoryGrain(_tenantId).GetUsersAsync();
        _clientId = users.FirstOrDefault(entry => entry.UserId == _tenantUserId)?.ClientId;
        if (_clientId is null)
        {
            _error = "Your account is not linked to a client, so you can't order.";
        }

        _newOrderGuid = Guid.NewGuid();
        return true;
    }

    private async Task<bool> LoadDraftAsync(string orderId)
    {
        var result = await ClusterClient.GetGrain<IOrderGrain>(orderId).GetOrderDraftAsync();
        if (result.IsFailure)
        {
            _error = result.Error.GetFormattedMessage();
            return false;
        }

        _draft = result.Value;
        _activeTab = FirstUnfinishedTab(result.Value);
        return true;
    }

    /// <summary>
    ///     Tab 1 is finished once the draft exists and tab 2 once it has a borrower. Documents are optional, so until tab 4 is
    ///     built, a draft with a borrower resumes on tab 3.
    /// </summary>
    private static int FirstUnfinishedTab(OrderDraft draft) => draft.BorrowerName is null ? BorrowerTab : DocumentsTab;

    private void RequestAndPropertySaved(OrderDraft draft)
    {
        var started = _draft is null;
        _draft = draft;
        _activeTab = BorrowerTab;

        if (started)
        {
            // The draft was just started: show its URL, so a reload resumes it.
            _loadedFor = _newOrderGuid;
            Navigation.NavigateTo($"orders/drafts/{_newOrderGuid}", replace: true);
        }
    }

    private void BorrowerAndAccessContactSaved(OrderDraft draft)
    {
        _draft = draft;
        _activeTab = DocumentsTab;
    }

    private void SupportingDocumentAttached(OrderDraft draft) => _draft = draft;
}
