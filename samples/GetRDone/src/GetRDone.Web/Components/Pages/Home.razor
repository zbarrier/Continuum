@page "/"
@attribute [Authorize]

<PageTitle>Home · Get-R-Done</PageTitle>

@* Everyone lands here; each role gets its own home. *@
<AuthorizeView Roles="client">
    <Authorized>
        <ClientHome />
    </Authorized>
    <NotAuthorized>
        <AuthorizeView Roles="@StaffRoles.AnyStaff" Context="staff">
            <Authorized>
                <StaffHome />
            </Authorized>
            <NotAuthorized>
                <MudText Typo="Typo.h4" GutterBottom="true">Home</MudText>
                <MudText Typo="Typo.body1">The home page for your role is not built yet.</MudText>
            </NotAuthorized>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>
