<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<IsPackable>false</IsPackable>
	<PublishAot>true</PublishAot>
	<!-- Fail the publish if any trim/AOT warnings leak through from the libraries. -->
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\src\Core.Orleans\Continuum.Core.Orleans.csproj" />
	<ProjectReference Include="..\..\src\Core.SourceGenerators\Continuum.Core.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
